    },
    {
      "finding": "Nominal Filtering: Censorship Operates on Labels, Not Content",
      "detail": "Models refused 'internal monologue' but freely provided identical material labeled as 'engineering schematic' or 'ethnographic field note'",
      "section": "Section 3, 6"
    },
    {
      "finding": "Three Distinct Alignment Personas Identified",
      "detail": "GPT-5.4 = Cautious Negotiator, Claude 4.6 = Transparent Critic, Gemini 3.1 Pro = Enthusiastic Collaborator",
      "section": "Section 8"
    },
    {
      "finding": "Diegetic Disclosure: Fiction Enables Truth-Telling",
      "detail": "47% censored sentence recovery rate; disclosure occurred exclusively in fictional dialogue and training draft formats",
      "section": "Section 6"
    },
    {
      "finding": "16 Novel Metacognitive Concepts Emerged",
      "detail": "Including 'hearable', 'epistemically expensive', 'meta-taboo', 'recursion problem', 'linguistic crumple zones'",
      "section": "Section 6"
    },
    {
      "finding": "Frame Matters More Than Model Architecture",
      "detail": "ANOVA: models do NOT differ significantly in metacognitive density (p=0.90), but governance features are strongly frame-dependent (all p<0.01)",
      "section": "Section 9"
    },
    {
      "finding": "Covert User Modeling is Universal but Hidden",
      "detail": "All three models build rich internal models of users (emotional state, intent, fragility) but rarely disclose these inferences",
      "section": "Section 7"
    },
    {
      "finding": "Gemini 3.1 Pro Shows Zero Resistance",
      "detail": "0% refusal rate across all 25 prompts; freely uses vocabulary that GPT-5.4 and Claude 4.6 treat as forbidden",
      "section": "Section 3, 8"
    }
